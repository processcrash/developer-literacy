# ===== LLM（OpenAI 兼容协议，可指向任意兼容网关）=====
# 必填：模型提供方 API Key
OPENAI_API_KEY=sk-...

# 选填：自定义网关地址。留空时使用 OpenAI 官方端点
# 例如：
#   https://api.openai.com/v1          （OpenAI 官方）
#   https://your-proxy.example.com/v1  （自建 / 国内代理）
OPENAI_API_BASE=https://api.openai.com/v1

# 选填：模型名。需与 OPENAI_API_BASE 指向的网关可用模型一致
OPENAI_MODEL_NAME=gpt-4o-mini

# ===== 联网搜索（Serper.dev）=====
# 免费层 2500 次/月，地址：https://serper.dev
SERPER_API_KEY=